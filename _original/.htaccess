FileETag None  
<ifModule mod_headers.c>  
Header unset ETag  
Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"  
Header set Pragma "no-cache"  
Header set Expires "Mon, 1 Jan 2010 01:00:00 GMT"  
</ifModule>

<IfModule mod_negotiation.c>
    Options +MultiViews
</IfModule>

RewriteEngine On
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^(.*)$ https://www.tpcg-live.de/$1 [R=301,L]

RewriteCond %{HTTP_HOST} !^www\.tpcg-live\.de$ [NC]
RewriteRule ^(.*)$ https://www.tpcg-live.de/$1 [L,R=301]

Redirect 301 http://tpcg-live.de/ https://www.tpcg-live.de
Redirect 301 http://www.tpcg-live.de/ https://www.tpcg-live.de
Redirect 301 https://tpcg-live.de/ https://www.tpcg-live.de

Redirect 301 https://www.tpcg-live.de/index.php https://www.tpcg-live.de

ErrorDocument 404 https://www.tpcg-live.de